---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getNoteEntries, getReadingTimeLabel } from '../../lib/content';
import { formatLongDate } from '../../lib/format';

export async function getStaticPaths() {
  const notes = await getNoteEntries();
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = (await getNoteEntries()).filter((note) => note.id !== entry.id).slice(0, 3);
---

<SiteLayout title={`${entry.data.title} | 迅雷实验室`} description={entry.data.summary}>
  <main class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <a href="/notes/" class="inline-flex items-center gap-3 font-mono text-[11px] tracking-[0.12em] text-white/52 transition-colors duration-300 hover:text-lab-accent">
      <span aria-hidden="true">←</span>返回技术专题
    </a>

    <section class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start lg:gap-16">
      <div>
        <p class="font-mono text-[10px] tracking-[0.2em] text-lab-accent">{entry.data.topic} / {entry.data.level}</p>
        <h1 class="mt-5 max-w-4xl font-display text-[clamp(2.4rem,5vw,5.2rem)] leading-[0.95] tracking-[-0.055em] text-white">{entry.data.title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-white/68 sm:text-xl">{entry.data.summary}</p>
      </div>
      <aside class="border border-lab-line bg-white/[0.03] p-6 sm:p-7">
        <div class="font-mono text-[10px] tracking-[0.16em] text-white/42">笔记信息 / NOTE INFO</div>
        <dl class="mt-6 space-y-5">
          <div><dt class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">专题</dt><dd class="mt-2 text-[1rem] leading-7 text-white/68">{entry.data.topic}</dd></div>
          <div><dt class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">难度</dt><dd class="mt-2 text-[1rem] leading-7 text-white/68">{entry.data.level}</dd></div>
          <div><dt class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">更新</dt><dd class="mt-2 text-[1rem] leading-7 text-white/68">{formatLongDate(entry.data.publishedAt)}</dd></div>
          <div><dt class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">阅读</dt><dd class="mt-2 text-[1rem] leading-7 text-white/68">{getReadingTimeLabel(entry.body)}</dd></div>
        </dl>
        {entry.data.keywords.length ? (
          <div class="mt-7 border-t border-lab-line pt-5">
            <div class="font-mono text-[10px] tracking-[0.12em] text-white/42">关键词</div>
            <div class="mt-3 flex flex-wrap gap-2">
              {entry.data.keywords.map((keyword) => (
                <span class="border border-lab-line px-2 py-0.5 font-mono text-[10px] text-white/58">{keyword}</span>
              ))}
            </div>
          </div>
        ) : null}
      </aside>
    </section>

    <article class="markdown-prose mt-14 max-w-4xl text-pretty">
      <Content />
    </article>

    {related.length ? (
      <section class="mt-20 border-t border-lab-line pt-10">
        <p class="font-mono text-[10px] tracking-[0.16em] text-lab-accent">继续阅读 / MORE NOTES</p>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {related.map((note) => (
            <a href={`/notes/${note.id}/`} class="group border border-lab-line p-5 transition-colors duration-300 hover:border-lab-accent">
              <div class="font-mono text-[10px] tracking-[0.1em] text-white/40">{note.data.topic}</div>
              <div class="mt-3 font-display text-lg leading-snug tracking-[-0.02em] text-white transition-colors duration-300 group-hover:text-lab-accent">{note.data.title}</div>
            </a>
          ))}
        </div>
      </section>
    ) : null}
  </main>
</SiteLayout>
