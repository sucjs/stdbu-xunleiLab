---
import SiteLayout from '../../layouts/SiteLayout.astro';

const videoExtensions = new Set(['.mp4', '.webm', '.ogg', '.mov']);
const videoModules = import.meta.glob('/public/vdso/*', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const videoFiles = Object.entries(videoModules)
  .filter(([filePath]) => videoExtensions.has(filePath.slice(filePath.lastIndexOf('.')).toLowerCase()))
  .map(([filePath, url]) => ({
    name: filePath.slice(filePath.lastIndexOf('/') + 1),
    url,
  }))
  .sort((left, right) => left.name.localeCompare(right.name, undefined, { numeric: true, sensitivity: 'base' }));

function getVideoType(fileName: string) {
  const extension = fileName.slice(fileName.lastIndexOf('.') + 1).toLowerCase();
  return extension === 'mov' ? 'video/quicktime' : `video/${extension}`;
}
---

<SiteLayout title="实验室动态" description="迅雷实验室的实验记录、竞赛现场和项目过程视频。">
  <main class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <section class="max-w-4xl">
      <p class="font-mono text-[10px] tracking-[0.2em] text-lab-accent">VIDEO LOG / 03</p>
      <h1 class="mt-5 font-display text-[clamp(3rem,7vw,7rem)] leading-[0.9] tracking-[-0.06em] text-white">实验室动态</h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-white/62 sm:text-xl">记录实验室里的调试、训练、比赛和项目过程。</p>
    </section>

    <section class="video-archive mt-14">
      {videoFiles.length ? (
        <div class="grid gap-6 md:grid-cols-2">
          {videoFiles.map((video, index) => (
            <article class="video-card group">
              <div class="video-card-frame">
                <video controls preload="metadata" playsinline>
                  <source src={video.url} type={getVideoType(video.name)} />
                  您的浏览器不支持视频播放。
                </video>
                <span class="video-card-index">VIDEO / {String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="mt-4 flex items-center justify-between gap-4">
                <h2 class="font-display text-2xl text-white">{video.name.replace(/\.[^.]+$/, '')}</h2>
                <span class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">PLAYBACK</span>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="video-empty border border-dashed border-lab-line p-10 text-center">
          <p class="font-mono text-sm tracking-[0.1em] text-lab-accent">NO VIDEO SIGNAL</p>
          <p class="mt-4 text-white/58">将 mp4、webm、ogg 或 mov 视频放入 public/vdso 后刷新页面。</p>
        </div>
      )}
    </section>
  </main>
</SiteLayout>
