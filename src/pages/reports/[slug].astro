---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { formatLongDate } from '../../lib/format';
import { getReportEntries } from '../../lib/content';

export async function getStaticPaths() {
  const reports = await getReportEntries();
  return reports.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  eyebrow={entry.data.label}
  summary={entry.data.summary}
  image={entry.data.image}
  backHref="/reports/"
  backLabel="返回项目成果"
  details={[
    { label: '记录日期', value: formatLongDate(entry.data.publishedAt) },
    { label: '成果摘要', value: entry.data.highlight },
    { label: '数据起点', value: entry.data.rangeStart },
    { label: '数据终点', value: entry.data.rangeEnd },
  ]}
>
  <Content />
</EntryLayout>
