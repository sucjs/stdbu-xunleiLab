---
import CollectionIndexLayout from '../../layouts/CollectionIndexLayout.astro';
import { getMissionEntries } from '../../lib/content';

const missions = await getMissionEntries();
---

<CollectionIndexLayout
  title="研究方向"
  eyebrow="Research Areas / 01"
  intro="迅雷实验室围绕智能车、电赛和机器人综合工程建立训练路径，让成员从基础知识进入真实项目。"
  description="迅雷实验室的研究方向：智能车竞赛、电子设计竞赛与机器人综合工程。"
>
  <div class="grid gap-0 border-t border-lab-line">
    {missions.map((mission, index) => (
      <a href={`/missions/${mission.id}/`} class="group grid gap-5 border-b border-lab-line py-8 transition-colors duration-300 hover:border-lab-accent md:grid-cols-[80px_minmax(0,1fr)_260px_30px] md:items-center md:gap-8">
        <span class="font-mono text-sm text-lab-accent">0{index + 1}</span>
        <div>
          <h2 class="font-display text-3xl tracking-[-0.04em] text-white transition-colors duration-300 group-hover:text-lab-accent sm:text-4xl">{mission.data.title}</h2>
          <p class="mt-3 max-w-2xl text-[1.02rem] leading-8 text-white/58">{mission.data.summary}</p>
        </div>
        <div class="grid gap-2 font-mono text-[10px] tracking-[0.1em] text-white/42">
          <span>{mission.data.status}</span>
          <span>{mission.data.vehicle}</span>
        </div>
        <span class="font-mono text-xl text-white/38 transition-all duration-300 group-hover:translate-x-1 group-hover:text-lab-accent" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</CollectionIndexLayout>
