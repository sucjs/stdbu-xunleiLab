---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getMissionEntries } from '../../lib/content';

export async function getStaticPaths() {
  const missions = await getMissionEntries();
  return missions.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  eyebrow="研究方向 / RESEARCH AREA"
  summary={entry.data.summary}
  image={entry.data.coverImage}
  backHref="/missions/"
  backLabel="返回研究方向"
  details={[
    { label: '方向状态', value: entry.data.status },
    { label: '实践平台', value: entry.data.vehicle },
    { label: '训练周期', value: entry.data.missionWindow },
    { label: '核心能力', value: entry.data.destination },
  ]}
>
  <Content />
</EntryLayout>
