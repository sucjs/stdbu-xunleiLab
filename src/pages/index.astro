---
import DepartureSection from '../components/DepartureSection';
import DiscoverySection from '../components/DiscoverySection';
import FooterSection from '../components/FooterSection';
import HeroShell from '../components/HeroShell';
import LabSourcesSection from '../components/LabSourcesSection.astro';
import LabStorySection from '../components/LabStorySection.astro';
import MissionsSection from '../components/MissionsSection';
import NotesSection from '../components/NotesSection.astro';
import PageLoader from '../components/PageLoader.astro';
import {
  footerDirectory,
  footerMeta,
  footerPolicies,
  heroContent,
  heroLeftNav,
  heroRightNav,
  mobileNav,
} from '../data/site';
import {
  getDepartureEntries,
  getMissionEntries,
  getNoteEntries,
  getReportEntries,
  toDiscoveryContent,
  toLaunchRow,
  toMissionCard,
  toNextDepartureContent,
  toSpectrumBars,
} from '../lib/content';
import '../styles/global.css';

const [missionEntries, reportEntries, departureEntries, noteEntries] = await Promise.all([
  getMissionEntries(),
  getReportEntries(),
  getDepartureEntries(),
  getNoteEntries(),
]);

const featuredReport = reportEntries[0];
const featuredDeparture = departureEntries[0];
---

<html lang="zh-CN" class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="迅雷实验室是山东工商学院信息与电子工程学院的学生科创实验室，以西校区实验楼 5401 为基地，专注智能车竞赛、电子设计竞赛与嵌入式工程实践。"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@500;600;700&display=swap"
    />
    <script is:inline>
      (() => {
        const key = 'thunder-lab-theme';
        const stored = window.localStorage.getItem(key);
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <noscript>
      <style>
        /* 无 JS 时 React 岛屿不会水合，入场动画会永远停在初始态
           （inline opacity:0），内容就看不见了。这里统一还原成可见。
           只在 noscript 内生效，正常浏览时不影响动画。 */
        main *[style*='opacity'] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <title>迅雷实验室 · 山东工商学院信息与电子工程学院</title>
  </head>
  <body class="bg-page-bg antialiased">
    <PageLoader />
    <main class="site-shell overflow-x-clip">
      <HeroShell
        client:load
        content={heroContent}
        leftNav={heroLeftNav}
        mobileNav={mobileNav}
        rightNav={heroRightNav}
      />
      <MissionsSection client:visible missions={missionEntries.map(toMissionCard)} />
      <LabStorySection />
      {featuredReport ? (
        <DiscoverySection
          client:visible
          bars={toSpectrumBars(featuredReport)}
          content={toDiscoveryContent(featuredReport)}
        />
      ) : null}
      {featuredDeparture ? (
        <DepartureSection
          client:visible
          content={toNextDepartureContent(featuredDeparture)}
          launches={departureEntries.map(toLaunchRow)}
        />
      ) : null}
      <NotesSection notes={noteEntries} />
      <LabSourcesSection />
      <FooterSection
        client:visible
        directory={footerDirectory}
        meta={footerMeta}
        policies={footerPolicies}
      />
    </main>
  </body>
</html>
