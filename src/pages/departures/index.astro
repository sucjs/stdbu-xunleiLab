---
import CollectionIndexLayout from '../../layouts/CollectionIndexLayout.astro';
import { getDepartureEntries } from '../../lib/content';

const departures = await getDepartureEntries();
---

<CollectionIndexLayout
  title="加入我们"
  eyebrow="Intake Process / 04"
  intro="公开课、笔试、面试和阶段性考核，帮助你在加入前了解实验室，也帮助团队找到愿意认真做工程的人。"
  description="了解迅雷实验室的公开课、笔试、面试和阶段性考核流程。"
>
  <div class="grid gap-0 border-t border-lab-line">
    {departures.map((entry, index) => (
      <a href={`/departures/${entry.id}/`} class="group grid gap-5 border-b border-lab-line py-8 transition-colors duration-300 hover:border-lab-accent md:grid-cols-[80px_minmax(0,1fr)_180px_30px] md:items-center md:gap-8">
        <span class="font-mono text-sm text-lab-accent">0{index + 1}</span>
        <div>
          <h2 class="font-display text-3xl tracking-[-0.04em] text-white transition-colors duration-300 group-hover:text-lab-accent sm:text-4xl">{entry.data.title}</h2>
          <p class="mt-3 max-w-2xl text-[1.02rem] leading-8 text-white/58">{entry.data.detail}</p>
        </div>
        <div class="font-mono text-[10px] tracking-[0.1em] text-white/42">{entry.data.date}<br />{entry.data.stage}</div>
        <span class="font-mono text-xl text-white/38 transition-all duration-300 group-hover:translate-x-1 group-hover:text-lab-accent" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</CollectionIndexLayout>
