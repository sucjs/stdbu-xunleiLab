---
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getDepartureEntries } from '../../lib/content';

export async function getStaticPaths() {
  const departures = await getDepartureEntries();
  return departures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  eyebrow={entry.data.stage}
  summary={entry.data.detail}
  image={entry.data.image}
  backHref="/departures/"
  backLabel="返回加入流程"
  details={[
    { label: '流程阶段', value: entry.data.date },
    { label: '时间安排', value: entry.data.time },
    { label: '考核方式', value: entry.data.stage },
  ]}
>
  <Content />
</EntryLayout>
