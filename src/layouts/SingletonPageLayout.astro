---
import SiteLayout from './SiteLayout.astro';

interface Highlight { label: string; value: string; }
interface Props {
  description?: string;
  eyebrow: string;
  highlights?: Highlight[];
  image?: string;
  summary: string;
  title: string;
}

const { description, eyebrow, highlights = [], image, summary, title } = Astro.props;
---

<SiteLayout title={`${title} | 迅雷实验室`} description={description ?? summary}>
  <main class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <section class={`relative isolate overflow-hidden border border-lab-line ${image ? 'min-h-[430px] sm:min-h-[540px]' : 'p-8 sm:p-10 lg:p-14'}`}>
      {image ? <img src={image} alt={title} class="absolute inset-0 h-full w-full object-cover opacity-55" /> : null}
      {image ? <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(8,10,11,0.94),rgba(8,10,11,0.55)_65%,rgba(8,10,11,0.68))]" /> : null}
      <div class={`relative z-10 ${image ? 'flex min-h-[430px] items-end p-8 sm:min-h-[540px] sm:p-10 lg:p-14' : ''}`}>
        <div class="max-w-5xl">
          <p class="font-mono text-[10px] tracking-[0.2em] text-lab-accent">{eyebrow}</p>
          <h1 class="mt-5 max-w-4xl font-display text-[clamp(3rem,7vw,7rem)] leading-[0.9] tracking-[-0.06em] text-white">{title}</h1>
          <p class="mt-7 max-w-3xl text-lg leading-8 text-white/68 sm:text-xl">{summary}</p>
        </div>
      </div>
    </section>

    <section class={`mt-12 ${highlights.length ? 'grid gap-10 md:grid-cols-[minmax(0,1fr)_300px] md:items-start lg:gap-16' : ''}`}>
      <article class="markdown-prose max-w-4xl text-pretty md:order-1"><slot /></article>
      {highlights.length ? (
        <aside class="order-first border border-lab-line bg-white/[0.03] p-6 sm:p-7 md:order-2 md:sticky md:top-28">
          <div class="font-mono text-[10px] tracking-[0.16em] text-white/42">关键资料 / CORE DATA</div>
          <dl class="mt-6 space-y-6">
            {highlights.map((item) => <div><dt class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">{item.label}</dt><dd class="mt-2 text-[1rem] leading-7 text-white/68">{item.value}</dd></div>)}
          </dl>
        </aside>
      ) : null}
    </section>
  </main>
</SiteLayout>
