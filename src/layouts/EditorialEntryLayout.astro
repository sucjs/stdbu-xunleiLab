---
import SiteLayout from './SiteLayout.astro';

interface DetailItem { label: string; value: string; }
interface Props {
  backHref: string;
  backLabel: string;
  description?: string;
  details: DetailItem[];
  eyebrow: string;
  image?: string;
  summary: string;
  title: string;
}

const { backHref, backLabel, description, details, eyebrow, image, summary, title } = Astro.props;
---

<SiteLayout title={`${title} | 迅雷实验室`} description={description ?? summary}>
  <main class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <a href={backHref} class="inline-flex items-center gap-3 font-mono text-[11px] tracking-[0.12em] text-white/52 transition-colors duration-300 hover:text-lab-accent"><span aria-hidden="true">←</span>{backLabel}</a>
    <section class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start lg:gap-20">
      <div class="max-w-4xl">
        <p class="font-mono text-[10px] tracking-[0.2em] text-lab-accent">{eyebrow}</p>
        <h1 class="mt-5 font-display text-[clamp(3rem,6vw,6.8rem)] leading-[0.9] tracking-[-0.06em] text-white">{title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-white/68 sm:text-xl">{summary}</p>
      </div>
      <aside class="border border-lab-line bg-white/[0.03] p-6 sm:p-7"><div class="font-mono text-[10px] tracking-[0.16em] text-white/42">动态资料 / FIELD DATA</div><dl class="mt-6 space-y-5">{details.map((item) => <div><dt class="font-mono text-[10px] tracking-[0.12em] text-lab-accent">{item.label}</dt><dd class="mt-2 text-[1rem] leading-7 text-white/68">{item.value}</dd></div>)}</dl></aside>
    </section>
    {image ? <div class="mt-12 overflow-hidden border border-lab-line"><img src={image} alt={title} class="aspect-[16/8] w-full object-cover" /></div> : null}
    <article class="markdown-prose mt-12 max-w-4xl text-pretty"><slot /></article>
  </main>
</SiteLayout>
