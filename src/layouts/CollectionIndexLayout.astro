---
import SiteLayout from './SiteLayout.astro';

interface Props {
  actionHref?: string;
  actionLabel?: string;
  description?: string;
  intro: string;
  title: string;
  eyebrow: string;
}

const { actionHref, actionLabel, description, eyebrow, intro, title } = Astro.props;
---

<SiteLayout title={`${title} | 迅雷实验室`} description={description ?? intro}>
  <main class="mx-auto max-w-7xl px-6 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <section class="grid gap-8 border-b border-lab-line pb-12 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] md:items-end">
      <div>
        <p class="font-mono text-[10px] tracking-[0.2em] text-lab-accent">{eyebrow}</p>
        <div class="mt-5 flex flex-wrap items-end gap-5 sm:gap-7">
          <h1 class="font-display text-[clamp(3rem,7vw,7rem)] leading-[0.9] tracking-[-0.06em] text-white">{title}</h1>
          {actionHref && actionLabel ? (
            <a
              href={actionHref}
              target="_blank"
              rel="noopener noreferrer"
              class="mb-1 inline-flex min-h-11 items-center gap-3 border border-lab-accent px-5 py-3 font-mono text-[12px] tracking-[0.06em] text-lab-accent transition-colors duration-300 hover:bg-lab-accent hover:text-accent-contrast sm:mb-2"
            >
              {actionLabel}
              <span aria-hidden="true">↗</span>
            </a>
          ) : null}
        </div>
      </div>
      <p class="max-w-xl text-lg leading-8 text-white/62 md:justify-self-end">{intro}</p>
    </section>
    <section class="mt-14"><slot /></section>
  </main>
</SiteLayout>
